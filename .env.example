[app]
env = development
debug = false
trace = false
token_key = change-me-with-a-random-64-character-hex-value
version = 1.0.0-portfolio
release = portfolio-demo
[company]
contact_encryption_key = change-me-with-base64-encoded-32-byte-random-key
[database]
type = mysql
hostname = 127.0.0.1
hostport = 33329
database = geo_portfolio_demo
username = portfolio
password = change-me
prefix = fa_
charset = utf8mb4
[redis]
hostname = 127.0.0.1
hostport = 6379
password = ""
select = 14
timeout = 2
persistent = false
[queue]
connector = Redis
default = default
retry_after = 90
max_attempts = 3
[ai]
provider = mock
queue = geo_ai_generation
max_attempts = 3
max_output_tokens = 2048
[content]
storage_driver = mock
[supplier]
driver = mock
mock_scenario = default
[visibility]
driver = mock
[publish]
auto_submit = true
[billing]
manual_adjust_enabled = true
